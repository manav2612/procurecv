      "link": null,
      "locked": false,
      "text": "main.py                 app assembly + CORS\nrouters/transcribe.py   WS handshake protocol\nrouters/sessions.py     REST CRUD: sessions\nrouters/segments.py     REST CRUD: segments\nstt.py                   faster-whisper + lock\nmodels.py / crud.py     SQLAlchemy + CRUD\ndatabase.py              engine, Depends(get_db)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "main.py                 app assembly + CORS\nrouters/transcribe.py   WS handshake protocol\nrouters/sessions.py     REST CRUD: sessions\nrouters/segments.py     REST CRUD: segments\nstt.py                   faster-whisper + lock\nmodels.py / crud.py     SQLAlchemy + CRUD\ndatabase.py              engine, Depends(get_db)",
      "lineHeight": 1.25
